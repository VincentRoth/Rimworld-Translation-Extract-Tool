    { "def": "*", "field": "*Desc", "context": "Description" },
    { "def": "*", "field": "*.label", "context": "Libellé d'un sous-élément de la def (liste, onglet ou infobulle) - court", "short": true },
    { "def": "*", "field": "*.description", "context": "Description d'un sous-élément de la def (infobulle)" }
  ],

  // keyedRules : "field" = motif sur le NOM de la clé Keyed (insensible à la casse, * = joker)
