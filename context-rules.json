{
  // Règles évaluées dans l'ordre : la première qui correspond gagne. Du plus spécifique au plus générique.
  // defRules : "def" = nom de type de def (ou d'une classe parente), "field" = nom du champ ou chemin (* = joker).
  //   "max"   = longueur FR visée (caractères) ; "short" = texte court : limite auto ≈ 1.3 x EN.
  "defRules": [
    // ---------- Statistiques (panneau Exosuit, fiche d'objet, panneaux de stats) ----------
    { "def": "StatDef", "field": "label", "context": "StatDef : nom de statistique affiché à gauche de la valeur (fiche d'objet, panneaux de stats, onglets du châssis/équipement) - la valeur est sur la même ligne : rester COURT", "short": true, "max": 22 },
    { "def": "StatDef", "field": "labelForFullStatList", "context": "StatDef : variante du nom utilisée dans la liste complète des stats (fiche d'info)", "short": true },
    { "def": "StatDef", "field": "formatString", "context": "StatDef : format d'affichage de la valeur (garder {0} et l'unité courte)", "short": true },
    { "def": "StatDef", "field": "description", "context": "StatDef : infobulle de la statistique (survol), longueur libre" },
    { "def": "StatCategoryDef", "field": "label", "context": "Titre de catégorie de stats (en-tête dans la fiche d'info)", "short": true },
    { "def": "StatPart*", "field": "*", "context": "Texte de calcul de stat (infobulle détaillant la valeur)" },

    // ---------- Objets / bâtiments ----------
    { "def": "ThingDef", "field": "label", "context": "ThingDef : nom de l'objet/bâtiment/créature (menu Architecte, inventaire, titre de sélection, infobulles) - minuscule en anglais, pas de point", "short": true, "soft": true },
    { "def": "ThingDef", "field": "labelPlural", "context": "ThingDef : pluriel du nom (piles, listes, messages)", "short": true, "soft": true },
    // Sandy's RPG Style Inventory : nom d'emplacement affiché en infobulle, tel quel (majuscule initiale, Conventions §2)
    { "def": "ItemSlotDef", "field": "label", "context": "ItemSlotDef (RPG Style Inventory) : nom d'emplacement d'équipement, affiché en infobulle tel quel - majuscule initiale", "short": true, "soft": true },
    { "def": "ThingDef", "field": "description", "context": "ThingDef : description (fiche d'info, infobulle du menu Architecte) - longueur libre" },
    { "def": "ThingDef", "field": "stuffProps.stuffAdjective", "context": "Adjectif de matériau placé devant le nom (ex. « en bois ») - très court", "short": true },
    { "def": "ThingDef", "field": "tools.*.label", "context": "Nom d'une attaque de mêlée (journal de combat, fiche d'info) - très court", "short": true },
    { "def": "ThingDef", "field": "tools.*.labelNoLocation", "context": "Nom d'attaque sans partie du corps (journal de combat)", "short": true },
    { "def": "ThingDef", "field": "verbs.*.label", "context": "Nom d'attaque à distance / capacité (fiche d'info, journal)", "short": true },
    { "def": "ThingDef", "field": "comps.*.fuelLabel", "context": "Libellé de carburant (jauge/infobulle du bâtiment) - court", "short": true },
    { "def": "ThingDef", "field": "comps.*.fuelGizmoLabel", "context": "Libellé de la barre de carburant (bouton/jauge du bâtiment) - court", "short": true },
    { "def": "ThingDef", "field": "comps.*", "context": "Texte d'un composant d'objet (jauge, bouton, message ou texte d'inspection du bâtiment)" },
    { "def": "ThingDef", "field": "*", "context": "ThingDef : texte associé à l'objet" },

    // ---------- Terrain, plantes, ressources ----------
    { "def": "TerrainDef", "field": "label", "context": "TerrainDef : nom de sol (menu Architecte, inspection)", "short": true, "soft": true },
    { "def": "TerrainDef", "field": "description", "context": "TerrainDef : description du sol (infobulle Architecte)" },
    { "def": "ThingCategoryDef", "field": "label", "context": "Catégorie d'objets (filtres de stockage, d'ordres de fabrication) - court", "short": true },
    { "def": "DesignationCategoryDef", "field": "label", "context": "Onglet du menu Architecte (bouton) - très court", "short": true, "max": 16 },
    { "def": "DesignationCategoryDef", "field": "description", "context": "Infobulle de l'onglet Architecte" },

    // ---------- Fabrication, recettes, travail ----------
    { "def": "RecipeDef", "field": "label", "context": "RecipeDef : nom de l'ordre de fabrication / opération chirurgicale (liste des ordres, menu chirurgie)", "short": true, "soft": true },
    { "def": "RecipeDef", "field": "jobString", "context": "RecipeDef : texte d'activité du colon pendant la tâche (barre d'info « {0} » = cible) - verbe à l'infinitif/gérondif" },
    { "def": "RecipeDef", "field": "description", "context": "RecipeDef : infobulle de l'ordre de fabrication" },
    { "def": "RecipeDef", "field": "*Message", "context": "Message affiché à l'écran après l'opération" },
    { "def": "WorkTypeDef", "field": "labelShort", "context": "WorkTypeDef : en-tête de colonne de l'onglet Travail (TRÈS court, ~8-10 car.)", "short": true, "max": 10 },
    { "def": "WorkTypeDef", "field": "pawnLabel", "context": "WorkTypeDef : intitulé du métier (ex. « Artiste » ), fiche du colon", "short": true },
    { "def": "WorkTypeDef", "field": "gerundLabel", "context": "WorkTypeDef : action en cours dans la barre d'info (gérondif)", "short": true },
    { "def": "WorkTypeDef", "field": "verb", "context": "WorkTypeDef : verbe d'activité (« Faire de l'art à »)" },
    { "def": "WorkTypeDef", "field": "description", "context": "WorkTypeDef : infobulle de l'en-tête de colonne (onglet Travail)" },
    { "def": "WorkGiverDef", "field": "label", "context": "WorkGiverDef : libellé de la tâche (liste de travail)", "short": true },
    { "def": "WorkGiverDef", "field": "verb", "context": "WorkGiverDef : verbe affiché à côté de la cible" },
    { "def": "WorkGiverDef", "field": "gerund", "context": "WorkGiverDef : action en cours (gérondif), barre d'info du colon" },
    { "def": "JobDef", "field": "reportString", "context": "JobDef : activité actuelle du colon dans la barre d'info/fiche (« {TargetA} » = cible à conserver)" },
    { "def": "DutyDef", "field": "*", "context": "Texte d'activité de groupe" },

    // ---------- Santé ----------
    { "def": "HediffDef", "field": "label", "context": "HediffDef : nom de l'affection/prothèse (onglet Santé, infobulle de la partie du corps)", "short": true },
    { "def": "HediffDef", "field": "labelNoun", "context": "HediffDef : nom commun (« une {0} », lettre/journal)", "short": true },
    { "def": "HediffDef", "field": "labelNounPretty", "context": "HediffDef : nom joli (journal de soins)", "short": true },
    { "def": "HediffDef", "field": "description", "context": "HediffDef : description (infobulle de l'onglet Santé)" },
    { "def": "HediffDef", "field": "stages.*.label", "context": "HediffDef : préfixe de gravité devant le nom (onglet Santé) - très court", "short": true },
    { "def": "HediffDef", "field": "stages.*.*", "context": "HediffDef : texte d'un stade de gravité (infobulle Santé / lettre)" },
    { "def": "HediffDef", "field": "comps.*", "context": "HediffDef : texte d'un composant (soins, permanence, lettres)" },
    { "def": "HediffDef", "field": "*", "context": "HediffDef : texte d'affection (onglet Santé, lettres)" },
    { "def": "BodyPartDef", "field": "label", "context": "BodyPartDef : nom de partie du corps (onglet Santé, journal)", "short": true },
    { "def": "BodyPartDef", "field": "labelShort", "context": "BodyPartDef : nom court de partie du corps", "short": true },
    { "def": "BodyDef", "field": "*", "context": "BodyDef : libellé personnalisé d'une partie du corps (onglet Santé)", "short": true },

    // ---------- Pensées / traits / besoins ----------
    { "def": "ThoughtDef", "field": "stages.*.label", "context": "ThoughtDef : nom de la pensée dans l'onglet Besoins (liste d'humeur) - court", "short": true },
    { "def": "ThoughtDef", "field": "stages.*.labelSocial", "context": "ThoughtDef : nom de l'opinion sociale (onglet Social)", "short": true },
    { "def": "ThoughtDef", "field": "stages.*.description", "context": "ThoughtDef : infobulle de la pensée (monologue du colon, 1re personne)" },
    { "def": "TraitDef", "field": "degreeDatas.*.label", "context": "TraitDef : nom du trait (fiche du colon, bio) - court", "short": true },
    { "def": "TraitDef", "field": "degreeDatas.*.description", "context": "TraitDef : infobulle du trait ({PAWN_nameDef} etc. à conserver)" },
    { "def": "NeedDef", "field": "label", "context": "NeedDef : nom du besoin (onglet Besoins, barre) - court", "short": true },
    { "def": "SkillDef", "field": "label", "context": "SkillDef : nom de compétence (fiche du colon)", "short": true },
    { "def": "SkillDef", "field": "skillLabel", "context": "SkillDef : nom de compétence court", "short": true },
    { "def": "BackstoryDef", "field": "*", "context": "BackstoryDef : titre/description d'historique (fiche du colon)" },
    { "def": "XenotypeDef", "field": "*", "context": "XenotypeDef : texte de xénotype (création de colon, fiche)" },
    { "def": "GeneDef", "field": "label", "context": "GeneDef : nom de gène (éditeur de gènes, fiche) - court", "short": true },
    { "def": "GeneDef", "field": "description", "context": "GeneDef : infobulle du gène" },
    { "def": "GeneDef", "field": "labelShortAdj", "context": "GeneDef : adjectif court du gène", "short": true },

    // ---------- Capacités / psychisme ----------
    { "def": "AbilityDef", "field": "label", "context": "AbilityDef : nom de la capacité (bouton de la barre de commandes + titre de l'infobulle) - TRÈS court", "short": true, "max": 22 },
    { "def": "AbilityDef", "field": "description", "context": "AbilityDef : infobulle du bouton de capacité" },
    { "def": "AbilityDef", "field": "*", "context": "AbilityDef : texte de capacité (confirmation, journal, message)" },
    { "def": "PsycastDef", "field": "*", "context": "Texte de psycast" },

    // ---------- Recherche ----------
    { "def": "ResearchProjectDef", "field": "label", "context": "ResearchProjectDef : nom du projet (arbre de recherche : bouton à largeur limitée) - court", "short": true, "max": 26 },
    { "def": "ResearchProjectDef", "field": "description", "context": "ResearchProjectDef : description (panneau de droite de l'onglet Recherche)" },
    { "def": "ResearchTabDef", "field": "label", "context": "Onglet de recherche (bouton)", "short": true },

    // ---------- Événements, lettres, états mentaux ----------
    { "def": "IncidentDef", "field": "letterLabel", "context": "IncidentDef : titre de la lettre (icône d'alerte à droite de l'écran) - court", "short": true },
