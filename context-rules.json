    { "def": "IncidentDef", "field": "*", "context": "IncidentDef : texte d'événement" },
    { "def": "MentalStateDef", "field": "*Letter*", "context": "MentalStateDef : lettre d'état mental (conserver les placeholders)" },
    { "def": "MentalStateDef", "field": "*", "context": "MentalStateDef : texte d'état mental (barre d'info, journal)" },
    { "def": "GameConditionDef", "field": "label", "context": "GameConditionDef : nom de condition (bandeau en haut à droite)", "short": true },
    { "def": "GameConditionDef", "field": "*", "context": "GameConditionDef : texte de condition météo/événement" },
    { "def": "QuestScriptDef", "field": "*", "context": "QuestScriptDef : règles de génération de texte de quête (grammaire à conserver)" },
    { "def": "RulePackDef", "field": "*", "context": "RulePackDef : règles de grammaire (journal de jeu, noms, descriptions d'art) - conserver les [mots-clés] et {0}" },

    // ---------- Factions, races, animaux ----------
    { "def": "FactionDef", "field": "label", "context": "FactionDef : nom du type de faction (liste des factions)", "short": true },
    { "def": "FactionDef", "field": "pawnSingular", "context": "FactionDef : membre (singulier)", "short": true },
    { "def": "FactionDef", "field": "pawnsPlural", "context": "FactionDef : membres (pluriel)", "short": true },
    { "def": "FactionDef", "field": "*", "context": "FactionDef : texte de faction" },
    { "def": "PawnKindDef", "field": "label", "context": "PawnKindDef : nom du type de personnage/animal (infobulle, liste de zone)", "short": true },
    { "def": "PawnKindDef", "field": "*", "context": "PawnKindDef : variante de nom (pluriel/genre)", "short": true },
    { "def": "LifeStageDef", "field": "*", "context": "LifeStageDef : nom de stade de vie", "short": true },
    { "def": "MemeDef", "field": "*", "context": "MemeDef : texte de mème (idéologie)" },
    { "def": "PreceptDef", "field": "*", "context": "PreceptDef : texte de précepte (idéologie)" },
    { "def": "RitualPatternDef", "field": "*", "context": "Texte de rituel" },
    { "def": "PawnRelationDef", "field": "*", "context": "PawnRelationDef : nom de relation (onglet Social)", "short": true },

    // ---------- Interface ----------
    { "def": "MainButtonDef", "field": "label", "context": "MainButtonDef : bouton de la barre du bas (très court)", "short": true, "max": 14 },
    { "def": "MainButtonDef", "field": "description", "context": "MainButtonDef : infobulle du bouton principal" },
    { "def": "KeyBindingDef", "field": "label", "context": "KeyBindingDef : nom de raccourci clavier (menu Options > Raccourcis)", "short": true },
    { "def": "KeyBindingCategoryDef", "field": "*", "context": "Catégorie de raccourcis (menu Options)" },
    { "def": "DamageDef", "field": "*", "context": "DamageDef : texte de type de dégât (journal, mort)" },

    // ---------- Génériques ----------
